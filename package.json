{
  "name": "jest-impact",
  "version": "0.0.2",
  "description": "Lists the Jest test files in each Nx project that a commit range can affect, using sovra for the import graph.",
  "license": "MIT",
  "author": "Pietro Marchini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmarchini/jest-impact.git"
  },
  "keywords": [
    "jest",
    "nx",
    "test-impact",
    "affected",
    "monorepo",
    "ci"
  ],
  "type": "module",
  "bin": {
    "jest-impact": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "start": "node src/cli.ts",
    "cases:bitwarden": "fixtures/bitwarden/setup.sh && node validation/run-cases.mjs fixtures/bitwarden .cache/bitwarden",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@yarnpkg/lockfile": "1.1.0",
    "micromatch": "4.0.8",
    "sovra": "0.5.0",
    "sucrase": "3.35.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/micromatch": "4.0.10",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
